# ==============================================================================
# AEGIS EARTH - ALERTNEST: Hyperlocal Flood Early-Warning & Evacuation Copilot
# Environment Configuration (Open-Data First Architecture)
# ==============================================================================

# Application Environment & Operational State
APP_ENV=development
ENVIRONMENT=development
SYSTEM_MODE=LIVE   # Options: LIVE, CACHED, DEGRADED, OFFLINE_DEMO
DEMO_MODE=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Database Configuration (PostgreSQL + PostGIS / SQLite fallback)
DATABASE_URL=sqlite:///./pravah.db
REDIS_URL=

# ==============================================================================
# PRIMARY OPEN-DATA STACK (No credentials required)
# ==============================================================================

# 1. Open-Meteo Weather (Public or Self-Hosted)
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# 2. GloFAS River Discharge / Flood API via Open-Meteo
GLOFAS_ENABLED=true
GLOFAS_BASE_URL=https://flood-api.open-meteo.com/v1/flood

# 3. ECMWF Open Data
ECMWF_ENABLED=true
ECMWF_DATA_PATH=

# 4. Sentinel-1 SAR Open Data (Local pipeline / AWS Open Data)
SENTINEL1_ENABLED=true
SENTINEL1_DATA_PATH=

# 5. NWDP / CWC National Water Data Portal / Tamil Nadu Water Resources
NWDP_ENABLED=true
NWDP_API_BASE_URL=https://indiawris.gov.in/wris/api

# 6. OpenStreetMap & Geocoding & Routing (OSRM)
OSM_DATA_PATH=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org

# ==============================================================================
# OPTIONAL AUTHORITATIVE SOURCES (Non-blocking adapters)
# ==============================================================================

# India Meteorological Department (IMD)
IMD_ENABLED=true
IMD_API_KEY=
IMD_BASE_URL=https://api.imd.gov.in/api/v1

# NDMA SACHET Common Alerting Protocol (CAP) Feed
SACHET_ENABLED=true
SACHET_RSS_URL=https://sachet.ndma.gov.in/alerts/rss

# ISRO MOSDAC (Meteorological & Oceanographic Satellite Data Archival Centre)
MOSDAC_ENABLED=false
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_BASE_URL=https://www.mosdac.gov.in/api

# Copernicus Data Space Ecosystem (Sentinel-1 SAR / Sentinel-2 MSI)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CATALOG_URL=https://catalogue.dataspace.copernicus.eu/resto/api

# NASA FIRMS (Fire Information for Resource Management System)
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# ==============================================================================
# COPILOT AI CONFIGURATION (Groq High-Speed Cloud Inference / Llama 3.3)
# ==============================================================================
# >>> PASTE YOUR GROQ API KEY HERE (e.g. gsk_...) <<<
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
